{
    "manifest_version": 3,
    "name": "Fixea",
    "version": "1.1.0",
    "description": "Herramienta de feedback visual para reportar y gestionar correcciones web en tiempo real.",
    "permissions": [
        "activeTab",
        "storage"
    ],
    "host_permissions": [
        "<all_urls>",
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Fixea Gestión"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "css": ["content.css"],
            "js": ["content.js"]
        }
    ],
    "background": {
        "service_worker": "background.js"
    }
}